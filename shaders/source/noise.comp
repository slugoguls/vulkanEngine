#version 450

// A simple hashing function to get a pseudo-random float from a 3D vector
float hash(uvec3 p)
{
	p = p * 73856093u;
    p = p ^ (p.yzx * 19349663u);
    p = p ^ (p.zxy * 83492791u);
    return float(p.x ^ p.y ^ p.z) / float(0xffffffffu);
}

// 3D Value Noise function
float value_noise(vec3 p)
{
      vec3 i = floor(p);
      vec3 f = fract(p);

      uvec3 u = uvec3(i);

      // Interpolate between the 8 corners of the cube
      float c00 = mix(hash(u + uvec3(0, 0, 0)), hash(u + uvec3(1, 0, 0)), f.x);
      float c01 = mix(hash(u + uvec3(0, 0, 1)), hash(u + uvec3(1, 0, 1)), f.x);
      float c10 = mix(hash(u + uvec3(0, 1, 0)), hash(u + uvec3(1, 1, 0)), f.x);
      float c11 = mix(hash(u + uvec3(0, 1, 1)), hash(u + uvec3(1, 1, 1)), f.x);

      float c0 = mix(c00, c10, f.y);
      float c1 = mix(c01, c11, f.y);

      return mix(c0, c1, f.z);
}

layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout (binding = 0, rgba8) uniform writeonly image3D noiseImage;

void main()
{
      ivec3 storePos = ivec3(gl_GlobalInvocationID.xyz);

      // Get the size of the image
      ivec3 size = imageSize(noiseImage);

      // Make sure we don't try to write outside the image
      if (storePos.x >= size.x || storePos.y >= size.y || storePos.z >= size.z) {
          return;
      }

      // The coordinate to sample the noise from. We can scale this to change the "zoom" of the noise.
      float frequency = 5.0;
      vec3 noiseCoord = vec3(storePos) / float(size.x) * frequency;

      // Calculate the noise value
      float noise = value_noise(noiseCoord);

      // Write the noise value to the image. We are writing it to all 4 channels (R, G, B, A).
      imageStore(noiseImage, storePos, vec4(noise, noise, noise, noise));
}