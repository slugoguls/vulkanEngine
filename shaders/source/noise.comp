#version 450

//---------------------------------------------------------
// Utility Functions
//---------------------------------------------------------

// Fade curve for smoother interpolation (Perlin-style)
vec3 fade(vec3 t) {
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

// Hash function to generate pseudorandom float from uvec3
float hash(uvec3 p) {
    p = p * 73856093u;
    p ^= (p.yzx * 19349663u);
    p ^= (p.zxy * 83492791u);
    return float(p.x ^ p.y ^ p.z) / float(0xffffffffu);
}

// 3D Value Noise
float value_noise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);

    uvec3 u = uvec3(i);
    vec3 w = fade(f);

    // Interpolate between cube corners
    float c000 = hash(u + uvec3(0, 0, 0));
    float c100 = hash(u + uvec3(1, 0, 0));
    float c010 = hash(u + uvec3(0, 1, 0));
    float c110 = hash(u + uvec3(1, 1, 0));
    float c001 = hash(u + uvec3(0, 0, 1));
    float c101 = hash(u + uvec3(1, 0, 1));
    float c011 = hash(u + uvec3(0, 1, 1));
    float c111 = hash(u + uvec3(1, 1, 1));

    float x00 = mix(c000, c100, w.x);
    float x10 = mix(c010, c110, w.x);
    float x01 = mix(c001, c101, w.x);
    float x11 = mix(c011, c111, w.x);

    float y0 = mix(x00, x10, w.y);
    float y1 = mix(x01, x11, w.y);

    return mix(y0, y1, w.z);
}

// Fractal Brownian Motion (fbm)
float fbm(vec3 p) {
    float total = 0.0;
    float amplitude = 0.5;
    float frequency = 1.0;
    int octaves = 6;

    for (int i = 0; i < octaves; i++) {
        total += value_noise(p * frequency) * amplitude;
        frequency *= 2.0;
        amplitude *= 0.5;
    }
    return total;
}

// Domain warped fbm (adds variation and wispiness)
float warped_fbm(vec3 p) {
    vec3 warp = vec3(
        fbm(p * 0.5 + 13.1),
        fbm(p * 0.5 + 47.7),
        fbm(p * 0.5 + 91.3)
    );
    return fbm(p + warp);
}

//---------------------------------------------------------
// Compute Shader
//---------------------------------------------------------

layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout (binding = 0, rgba8) uniform writeonly image3D noiseImage;

void main() {
    ivec3 storePos = ivec3(gl_GlobalInvocationID.xyz);

    // Image bounds
    ivec3 size = imageSize(noiseImage);
    if (any(greaterThanEqual(storePos, size))) {
        return;
    }

    // Normalize coordinates into [0, 1] range
    vec3 uvw = vec3(storePos) / vec3(size);

    // Frequency controls cloud scale
    float frequency = 5.0;

    // Get warped fbm noise
    float noise = warped_fbm(uvw * frequency);

    // Remap noise into a "cloud density" range
    noise = smoothstep(0.4, 0.8, noise);

    // Store into 3D texture
    // RGB = grayscale noise, A = density
    imageStore(noiseImage, storePos, vec4(noise, noise, noise, noise));
}
