  #version 450

  layout (local_size_x = 16, local_size_y = 16) in;

  layout (binding = 0, rgba16f) uniform writeonly image2D outputImage;
  layout (binding = 1) uniform sampler3D noiseTexture;

  layout(push_constant) uniform PushConstants {
      mat4 invViewProj;
      vec4 cameraPos;
  } pushConstants;

  // Function to get the ray direction for a given pixel
  vec3 get_ray_direction(vec2 uv, mat4 invViewProj) {
      vec4 clip = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
      vec4 view = invViewProj * clip;
      view = view / view.w;
      vec3 world_pos = vec3(view);
      return normalize(world_pos - pushConstants.cameraPos.xyz);
  }

  void main()
{
    ivec2 storePos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if (storePos.x >= size.x || storePos.y >= size.y) {
        return;
    }

    vec2 uv = vec2(storePos) / vec2(size);

    vec3 rayOrigin = pushConstants.cameraPos.xyz;
    vec3 rayDir = get_ray_direction(uv, pushConstants.invViewProj);

    float accumulatedDensity = 0.0;
    int numSteps = 128;
    float stepSize = 8000.0 / float(numSteps);

    for (int i = 0; i < numSteps; i++) {
        vec3 currentPos = rayOrigin + rayDir * (float(i) * stepSize);

        // Simple check to only draw clouds in a certain height range
        if (currentPos.y > 1000.0 && currentPos.y < 2000.0) {
            // Sample the 3D noise texture
            float density = texture(noiseTexture, currentPos / 5000.0).r; // Scale the coordinates to change cloud size

            // Remap the density to create more defined cloud shapes
            density = smoothstep(0.5, 0.7, density);

            if (density > 0.0) {
                accumulatedDensity += density;
            }
        }
    }

    // Use the accumulated density to determine the final color
    vec4 finalColor = vec4(1.0, 1.0, 1.0, accumulatedDensity * 0.015); // The 0.015 is a tweaking factor

    imageStore(outputImage, storePos, finalColor);
}